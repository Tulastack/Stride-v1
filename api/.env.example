PORT=3000

# Aurora DSQL connection (PostgreSQL-compatible)
DB_HOST=<your-cluster-endpoint>.dsql.us-east-1.on.aws
DB_PORT=5432
DB_NAME=postgres
DB_USER=admin
DB_SSL=true

# IAM Auth — set to "true" to use IAM token auth instead of DB_PASSWORD.
# When true, the task role must have dsql:DbConnectAdmin permission.
# When false (local dev), provide DB_PASSWORD instead.
DB_USE_IAM_AUTH=false
DB_PASSWORD=<your-password-for-local-dev>

AWS_REGION=us-east-1

# Cognito (get these from terraform output after applying)
COGNITO_USER_POOL_ID=<your-user-pool-id>
COGNITO_CLIENT_ID=<your-client-id>
