# Copy this to terraform.tfvars and fill in the values

aws_region  = "us-east-1"
environment = "production"

vpc_id = "vpc-0e5f3ce34a6b31884"

public_subnet_ids = [
  "subnet-04e2da0c0914b6dc3",
  "subnet-0fda307b1c8d50b21",
  "subnet-0f14510352d3a9d76",
]

# ─── Secrets (get from respective services) ───────────────────────
supabase_url    = "https://your-project.supabase.co"
internal_secret = "generate-a-random-string-here"
google_api_key  = "your-google-api-key"
groq_api_key    = "your-groq-api-key"
sentry_dsn_api  = ""
sentry_dsn_worker = ""

# ─── TLS + alerting (REQUIRED before real launch) ─────────────────
# ACM cert for the ALB HTTPS listener; empty keeps HTTP-only dev mode.
acm_certificate_arn = ""
# Email that receives CloudWatch alarm pages (confirm the SNS subscription).
alert_email = ""
