# ─── Server Configuration ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL) ──────────────────────────────────────────
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://stride:stride_dev@localhost:5432/stride

# ─── Supabase Authentication ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Optional JWT Secret if using symmetric HMAC signatures (JWKS is default)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── S3 Video Storage ───────────────────────────────────────────────
S3_BUCKET=stride-videos-dev
AWS_REGION=us-east-1
# Set this only for local simulation (e.g. http://localhost:4566 for LocalStack)
AWS_ENDPOINT=

# ─── SQS Queue ──────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/stride-analysis-dev

# ─── LLM Configuration ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Security & Observability ───────────────────────────────────────
INTERNAL_API_SECRET=your-internal-shared-secret-token
SENTRY_DSN=
