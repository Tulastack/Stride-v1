# ─── Server Configuration ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Bind address (default 0.0.0.0 so phones on the LAN can reach a dev API)
HOST=
# Lock down in production, e.g. https://app.stride.example
CORS_ORIGIN=

# ─── Database ───────────────────────────────────────────────────────
# Standard Postgres (default): postgres://user:password@host:port/database
DATABASE_URL=postgres://stride:stride_dev@localhost:5432/stride
# Aurora DSQL (opt-in; overrides DATABASE_URL when set): IAM token auth + TLS
DSQL_ENDPOINT=
DSQL_REGION=
DSQL_USER=
DSQL_DATABASE=

# ─── Supabase Authentication ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server-only, NEVER shipped to clients): enables full
# account deletion of the Supabase auth user via DELETE /users/me.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Video Storage ──────────────────────────────────────────────────
# 's3' (default) or 'local' (Docker-free dev: blob PUTs to this API)
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=
# Base URL phones can reach when the API builds local blob/stream URLs
PUBLIC_API_URL=
S3_BUCKET=stride-videos-dev
AWS_REGION=us-east-1
# Set this only for local simulation (e.g. http://localhost:4566 for LocalStack)
AWS_ENDPOINT=

# ─── SQS Queue ──────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/stride-analysis-dev

# ─── LLM Configuration (coach) ──────────────────────────────────────
# The coach agent + fallback run on Groq — this key is REQUIRED for coach chat.
GROQ_API_KEY=your-groq-api-key
# Optional model override (defaults in src/lib/coach.ts)
GROQ_MODEL=

# ─── Security & Observability ───────────────────────────────────────
# REQUIRED in production — /internal/* callbacks are rejected without it.
# Must match the ML worker's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=your-internal-shared-secret-token
SENTRY_DSN=
