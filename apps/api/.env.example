# ─── Server Configuration ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Bind address (default 0.0.0.0 so phones on the LAN can reach a dev API)
HOST=
# Lock down in production, e.g. https://app.stride.example
CORS_ORIGIN=

# ─── Database ───────────────────────────────────────────────────────
# Standard Postgres (default): postgres://user:password@host:port/database
DATABASE_URL=postgres://stride:stride_dev@localhost:5432/stride
# Aurora DSQL (opt-in; overrides DATABASE_URL when set): IAM token auth + TLS
DSQL_ENDPOINT=
DSQL_REGION=
DSQL_USER=
DSQL_DATABASE=

# ─── Supabase Authentication ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server-only, NEVER shipped to clients): enables full
# account deletion of the Supabase auth user via DELETE /users/me.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Video Storage ──────────────────────────────────────────────────
# 's3' (default) or 'local' (Docker-free dev: blob PUTs to this API)
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=
# Base URL phones can reach when the API builds local blob/stream URLs
PUBLIC_API_URL=
S3_BUCKET=stride-videos-dev
AWS_REGION=us-east-1
# Set this only for local simulation (e.g. http://localhost:4566 for LocalStack)
AWS_ENDPOINT=

# ─── SQS Queue ──────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/stride-analysis-dev

# ─── LLM Configuration (coach) ──────────────────────────────────────
# The coach needs ONE of these keys. Default provider is OpenRouter serving
# Gemma 4 31B on its free endpoint (hosted, $0, and it supports the function
# calling the coach agent's tool loop depends on). Free key: openrouter.ai/keys
#
# Free-tier budget: 20 requests/min and 50 requests/DAY. The agent makes up to
# 5 calls per athlete message, so plan on roughly 10-25 messages a day before
# it 429s. Buying $10 of credits once raises the daily cap to 1000.
OPENROUTER_API_KEY=your-openrouter-api-key

# Alternative provider, kept working. If only this key is set the coach uses
# Groq; set LLM_PROVIDER to force one when both keys are present.
GROQ_API_KEY=

# Optional overrides (see src/lib/coach/provider.ts)
#   LLM_PROVIDER    openrouter | groq
#   LLM_MODEL       e.g. google/gemma-4-31b-it  (drop ':free' for the paid endpoint)
#   LLM_BASE_URL    any other OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# ─── Offline biomechanics research pipeline (scripts/research/) ────
# Not used by the running API — only by `npm run research:metric`, a
# manually-invoked, human-reviewed offline batch job. Real, billed Opus 5 +
# web-search calls; never called from the request path.
ANTHROPIC_API_KEY=

# ─── Security & Observability ───────────────────────────────────────
# REQUIRED in production — /internal/* callbacks are rejected without it.
# Must match the ML worker's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=your-internal-shared-secret-token
SENTRY_DSN=
