{
  "expo": {
    "name": "Stride",
    "slug": "stride-sprint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stride.sprint"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D17"
      },
      "package": "com.stride.sprint"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stride to access your camera to capture and analyze your sprint form.",
          "microphonePermission": "Allow Stride to access your microphone during sprint recording."
        }
      ],
      "expo-video"
    ],
    "scheme": "stride"
  }
}
