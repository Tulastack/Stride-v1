# Mobile app config. EXPO_PUBLIC_* values are compiled INTO the app, so only
# public values go here (never a service_role / secret key).
#
# Release builds (TestFlight / App Store) get these from the EAS "production"
# environment (eas env:list --environment production), not from this file.
# In development the API host is derived from the Metro server, so
# EXPO_PUBLIC_API_BASE_URL can stay unset locally.

EXPO_PUBLIC_API_BASE_URL=https://api.strideforrunners.com
EXPO_PUBLIC_SUPABASE_URL=https://rcmllqdxcxauebtowimy.supabase.co
# Supabase publishable (anon) key: public by design, protected by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_mD8ahZJYNO6xlROS_YCLsA_dUvUMTDU
