{
  "name": "stride",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@stride/api",
    "dev:mobile": "turbo run dev --filter=@stride/mobile",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "test:env:up": "docker compose -f infra/docker-compose.test.yml up -d && sleep 5",
    "test:env:down": "docker compose -f infra/docker-compose.test.yml down -v",
    "e2e:full": "npm run e2e:full --workspace=packages/test-orchestrator"
  },
  "devDependencies": {
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "hermes-parser": "^0.36.1",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
